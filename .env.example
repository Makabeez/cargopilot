# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Defaults shown. Run `npm run agent:models` to list the Nemotron ids your key can call.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: JSON merged into every chat/completions body (e.g. reasoning toggles).
# NEBIUS_EXTRA_BODY={}
# AGENT_TEMPERATURE=0.2

# Spend guards for a public deployment (per server instance)
AGENT_RATE_PER_10MIN=30
AGENT_MAX_LIVE_PER_HOUR=300
