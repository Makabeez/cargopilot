# Nebius Token Factory — https://tokenfactory.nebius.com
NEBIUS_API_KEY=
# Defaults shown. Run `npm run agent:models` to list the Nemotron ids your key can call.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: JSON merged into every chat/completions body (e.g. reasoning toggles).
# NEBIUS_EXTRA_BODY={}
# AGENT_TEMPERATURE=0.2

# Spend guards for a public deployment (per server instance)
AGENT_RATE_PER_10MIN=20
AGENT_MAX_LIVE_PER_HOUR=120
# Also set a spend limit on the Nebius key itself: these guards are per server instance.

# Zetaris (Open Agent build): federated station evidence. Unset → the offline mirror answers (labelled).
# REST SQL endpoint of YOUR Zetaris instance, reachable from where this app runs (a tunnel for a local install).
# ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# ZETARIS_API_KEY=        # Management → API Tokens (server only; never in the browser)
# ZETARIS_ORG_ID=1        # Management → Organisation

# Meterless Scout signs its execution contracts with this secret (any long random string).
# SCOUT_CONTRACT_SECRET=
